# ========================================================
# EXEMPLE DE CONFIGURATION - MEDEQUI BACKEND
# ========================================================

# Port d'écoute de l'API
PORT=8081

# Connexion MySQL (Port standard XAMPP/WAMP: 3306 ou 3307)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=medequi

# Clé secrète JWT (générez une valeur aléatoire avec la commande indiquée dans le README)
JWT_SECRET=remplacer_par_une_cle_aleatoire_de_64_caracteres
